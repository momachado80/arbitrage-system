{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "dashboard/Dockerfile.postEventReversionObserver",
    "watchPatterns": [
      "dashboard/lib/postEventReversionHypothesis.ts",
      "dashboard/lib/catalystObservationSchedule.ts",
      "dashboard/lib/marketSuitabilityGate.ts",
      "dashboard/lib/marketUniverseQuality.ts",
      "dashboard/lib/polymarketClient.ts",
      "dashboard/scripts/buildCatalystObservationPlan.ts",
      "dashboard/scripts/runPostEventReversionScout.ts",
      "dashboard/docker-entrypoint-post-event-reversion-observer.sh",
      "dashboard/Dockerfile.postEventReversionObserver"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
