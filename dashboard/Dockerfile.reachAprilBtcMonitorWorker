# Contexto de build = raiz do repo (monorepo): docker build -f dashboard/Dockerfile.reachAprilBtcMonitorWorker .
FROM node:18.20-alpine

WORKDIR /app

COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm ci --no-cache --ignore-scripts 2>/dev/null || npm install --no-cache --ignore-scripts

COPY dashboard/lib ./lib
COPY dashboard/scripts ./scripts
COPY dashboard/tsconfig.json dashboard/tsconfig.worker.json ./
COPY dashboard/docker-entrypoint-reach-april-btc-monitor.sh /docker-entrypoint-reach-april-btc-monitor.sh
# Shim `uvicorn` igual ao worker 31552: o projeto Railway define startCommand uvicorn na raíz;
# assim o comando project-level arranca este worker Node sem alterar a strategy.
RUN chmod +x /docker-entrypoint-reach-april-btc-monitor.sh \
  && printf '%s\n' '#!/bin/sh' 'exec /docker-entrypoint-reach-april-btc-monitor.sh' > /usr/local/bin/uvicorn \
  && chmod +x /usr/local/bin/uvicorn

ENV NODE_ENV=production
ENV PATH="/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
