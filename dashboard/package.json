{
  "name": "polymarket-terminal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "bot": "npx ts-node -P tsconfig.worker.json botRunner.ts",
    "lint": "next lint",
    "shadow:preflight": "npx ts-node -P tsconfig.worker.json scripts/shadow-preflight.ts",
    "shadow:deploy-check": "npx ts-node -P tsconfig.worker.json scripts/shadow-deploy-check.ts",
    "shadow:snapshot": "npx ts-node -P tsconfig.worker.json scripts/shadow-snapshot.ts",
    "shadow:brief": "npx ts-node -P tsconfig.worker.json scripts/shadow-brief.ts",
    "shadow:judge": "npx ts-node -P tsconfig.worker.json scripts/shadow-judge.ts",
    "shadow:full-check": "npx ts-node -P tsconfig.worker.json scripts/shadow-full-check.ts",
    "check:shadow-only": "ts-node -P tsconfig.worker.json scripts/assertCrossVenueAnchor1823789ShadowOnly.ts",
    "readiness:microcapital": "ts-node -P tsconfig.worker.json scripts/readiness/microcapital-readiness.ts",
    "readiness:microcapital:probes": "ENABLE_READINESS_SYNTHETIC_PROBES=true ts-node -P tsconfig.worker.json scripts/readiness/microcapital-readiness.ts",
    "readiness:collect-markouts": "ts-node -P tsconfig.worker.json scripts/readiness/collect-markout-followups.ts",
    "readiness:watch-markouts": "ts-node -P tsconfig.worker.json scripts/readiness/watch-markout-followups.ts --watch",
    "readiness:watch-markouts:once": "ts-node -P tsconfig.worker.json scripts/readiness/watch-markout-followups.ts --once",
    "test": "ts-node -P tsconfig.worker.json tests/readiness/run-readiness-tests.ts",
    "test:readiness": "ts-node -P tsconfig.worker.json tests/readiness/run-readiness-tests.ts"
  },
  "dependencies": {
    "next": "13.5.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "ts-node": "^10.9.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
